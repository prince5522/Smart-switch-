<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Switch v1.2</title>
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="style.css?v=1.2">
</head>
<body>
    <div class="app">
        <!-- AUTHENTICATION CONTAINER -->
        <div id="authContainer" class="login-screen">
            <div class="logo">⚡</div>
            <h2>SMART SWITCH</h2>
            <p id="authSubtitle" class="subtitle">Please log in to control devices</p>
            
            <!-- AUTH NAVIGATION TABS -->
            <div class="auth-tabs">
                <button id="loginTabBtn" class="auth-tab active">Log In</button>
                <button id="registerTabBtn" class="auth-tab">Create Account</button>
            </div>

            <!-- LOGIN FORM -->
            <form id="loginForm" class="auth-form">
                <div class="input-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" placeholder="Enter username" required>
                </div>
                <div class="input-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" placeholder="Enter password" required>
                </div>
                <div class="forgot-link-container">
                    <a href="#" id="forgotPasswordLink" class="forgot-link">Forgot Password?</a>
                </div>
                <p id="loginError" class="auth-message error"></p>
                <button type="submit" class="login-button">LOG IN</button>
            </form>

            <!-- REGISTER FORM -->
            <form id="registerForm" class="auth-form hidden">
                <div class="input-group">
                    <label for="regUsername">Username</label>
                    <input type="text" id="regUsername" placeholder="Choose a username" required>
                </div>
                <div class="input-group">
                    <label for="regPassword">Password</label>
                    <input type="password" id="regPassword" placeholder="Choose a password" required>
                </div>
                <div class="input-group">
                    <label for="regConfirmPassword">Confirm Password</label>
                    <input type="password" id="regConfirmPassword" placeholder="Confirm password" required>
                </div>
                <p id="registerMsg" class="auth-message"></p>
                <button type="submit" class="login-button">CREATE ACCOUNT</button>
            </form>

            <!-- FORGOT PASSWORD FORM -->
            <form id="forgotForm" class="auth-form hidden">
                <p class="form-desc">Enter your username below to receive password recovery instructions or reset your credentials.</p>
                <div class="input-group">
                    <label for="forgotUsername">Username</label>
                    <input type="text" id="forgotUsername" placeholder="Enter registered username" required>
                </div>
                <p id="forgotMsg" class="auth-message"></p>
                <button type="submit" class="login-button">RESET PASSWORD</button>
                <div class="back-link-container">
                    <a href="#" id="backToLoginLink" class="forgot-link">&larr; Back to Login</a>
                </div>
            </form>
        </div>

        <!-- MAIN APP INTERFACE -->
        <div id="mainApp" class="main-app hidden">
            <header>
                <div class="logo">⚡</div>
                <div>
                    <h1>SMART SWITCH</h1>
                    <p>Phone Controlled Electrical Switch • v1.2</p>
                </div>
                <button id="logoutButton" class="logout-button">Logout</button>
            </header>
            <main>
                <section class="device-card">
                    <div class="device-top">
                        <div>
                            <h2 id="deviceNameDisplay">Living Room</h2>
                            <p>Electrical Switch 01</p>
                        </div>
                        <div id="connection" class="connection">
                            Offline
                        </div>
                    </div>
                    <div id="statusCircle" class="status-circle off">
                        <span id="statusIcon">⚡</span>
                        <strong id="statusText">OFF</strong>
                    </div>
                    <div class="control-buttons">
                        <button id="onButton" class="control-button on-button">TURN ON</button>
                        <button id="offButton" class="control-button off-button">TURN OFF</button>
                    </div>
                </section>

                <!-- ADMIN CONTROL PANEL (Only visible to Admin role) -->
                <section id="adminPanel" class="info-card hidden">
                    <h3>⚙️ Admin Management Panel</h3>
                    <div class="info-row">
                        <span>Current User Role</span>
                        <strong style="color: #007bff;">ADMIN</strong>
                    </div>
                    <div class="info-row">
                        <span>Endpoint Config</span>
                        <input type="text" id="endpointInput" placeholder="http://192.168.1.100" style="padding: 4px 8px; font-size: 12px;">
                    </div>
                    <button id="saveEndpointBtn" style="margin-top: 8px; padding: 6px 12px; cursor: pointer;">Save Endpoint</button>
                </section>

                <section class="info-card">
                    <div class="info-row">
                        <span>Device</span>
                        <strong>SWITCH 01</strong>
                    </div>
                    <div class="info-row">
                        <span>Connection</span>
                        <strong id="connectionText">Disconnected</strong>
                    </div>
                    <div class="info-row">
                        <span>Power Status</span>
                        <strong id="powerText">OFF</strong>
                    </div>
                    <div class="info-row">
                        <span>App Version</span>
                        <strong>v1.2</strong>
                    </div>
                </section>
            </main>
            <footer>
                <p>SMART SWITCH PROJECT</p>
                <small>Arduino + ESP8266 | v1.2</small>
                <p class="copyright">&copy; 2026 Created by Newton Maina &amp; Peter Wanyoike. All rights reserved.</p>
            </footer>
        </div>
    </div>
    <script src="app.js?v=1.2"></script>
</body>
</html>
